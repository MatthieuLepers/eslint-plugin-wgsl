{
  "name": "eslint-plugin-wgsl",
  "author": "Matthieu LEPERS",
  "version": "1.0.0",
  "description": "ESLint plugin for validating WGSL shader files",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "eslint",
    "eslint-plugin",
    "wgsl",
    "webgpu",
    "shader",
    "linter"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup src/index.ts src/parser.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "wgsl-linter": "^0.5.0"
  },
  "devDependencies": {
    "@types/eslint": "^8.56.12",
    "@types/node": "^26.6.5",
    "eslint": "^8.57.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "eslint": "^8.40.0"
  }
}
